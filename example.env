VITE_DISCORD_CLIENT_ID=YOUR_DISCORD_CLIENT_ID_HERE
DISCORD_CLIENT_SECRET=YOUR_DISCORD_CLIENT_SECRET

# Discord Bot Token (for slash commands and daily message management)
# Get this from Discord Developer Portal > Bot > Token
DISCORD_BOT_TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# Server deployment: comma-separated list of allowed origins for CORS
# Use * to allow all origins (not recommended for production)
ALLOWED_ORIGINS=https://your-app.vercel.app,http://localhost:5173

# Client deployment: URL of your hosted server (leave empty for same-origin)
VITE_API_URL=https://your-server.railway.app

# Redis URL for game state persistence (optional - falls back to in-memory)
# For Railway Redis: Use the variable ${{Redis.REDIS_URL}} which auto-populates
# Supports: redis://localhost:6379, rediss://... for TLS, or full Redis URLs
# Player state persists for 48 hours with per-player keys
REDIS_URL=

# Phase 6 learning analytics and cross-device Saved Words. These are server-only
# values; never expose them through a VITE_* variable. Production learning data
# remains disabled unless all values below and REDIS_URL are configured.
LEARNING_ANALYTICS_ENABLED=false
APP_SESSION_SECRET=
ANALYTICS_HMAC_SECRET=
ANALYTICS_ADMIN_TOKEN=

# Set this explicitly on deployed server services.
NODE_ENV=development

# Optional local-only helper. Never enable this in a deployed environment.
ALLOW_DEV_SESSION=false

# Debug WebSocket messages (set to 'true' to enable)
DEBUG_WS=false

# Debug leaderboard messages (set to '1' or 'true' to enable)
DEBUG_LEADERBOARD=0

# Build-time only: used by `cd engine; npm run dictionary:refresh` when an
# official KRDICT bulk archive is not supplied. Never expose this as VITE_*.
KRDICT_API_KEY=
